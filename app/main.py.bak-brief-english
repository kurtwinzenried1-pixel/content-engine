    requires_human_review: bool = True
    delivery_status: str = "pending"


def load_job(job_id: str):
    job_file = JOBS_DIR / f"{job_id}.json"

    if not job_file.exists():
        raise HTTPException(
            status_code=404,
            detail="Job not found",
        )

    return job_file, json.loads(
        job_file.read_text(
            encoding="utf-8-sig"
        )
    )


